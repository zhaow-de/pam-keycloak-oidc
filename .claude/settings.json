{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go tool cover:*)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(go env:*)",
      "Bash(go version)",
      "Bash(go mod download:*)",
      "Bash(go mod verify:*)",
      "Bash(gofmt -l:*)",
      "Bash(cz version)",
      "Bash(cz bump --get-next)",
      "Bash(make build)",
      "Bash(make build_all)",
      "Bash(make all)",
      "Bash(make clean)",
      "Bash(make help)",
      "Bash(hugo)",
      "Bash(hugo --gc --minify:*)",
      "Bash(hugo version)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git describe:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git tag -l:*)",
      "Bash(git tag --list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git submodule status:*)",
      "Bash(git submodule update --init --recursive)",
      "Bash(git fetch:*)",
      "Bash(git ls-remote:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(pre-commit run:*)",
      "Bash(cz version:*)",
      "Bash(gh pr checkout:*)",
      "Bash(git stash list:*)"
    ]
  }
}
